# Copy this file to .env and set your own long password and Pollinations secret key.
APP_NAME=YM-CORE X
APP_PASSWORD=change-this-password
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
POLLINATIONS_API_KEY=
DATABASE_PATH=./data/ym-core.db
HOST=127.0.0.1
PORT=8000
# Set true when served over HTTPS. Keep false for localhost HTTP.
SECURE_COOKIES=false
